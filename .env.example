# Copy to .env and adjust. Every value has a development default.

# Postgres with PostGIS (docker compose up -d db)
DATABASE_URL=postgres://wx:wx@127.0.0.1:5433/wx

# HTTP listen address
BIND_ADDR=127.0.0.1:8080

# Where tiles and grids are stored.
#   file:///absolute/path        local directory (development)
#   s3://bucket-name             S3-compatible storage such as Cloudflare R2;
#                                also set the S3_* variables below
STORE_URL=file://./data/store
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# What to run, comma separated. Leave unset to run everything.
# Names are: alerts, stations, a source family (mrms, rtma, hrrr, gfs, nbm,
# gdps, hrdps, icon, dmi, arome, cptec, opera, dwd_radar, dpc, jma, cwa,
# cmorph, gmgsi, goes) or a single source id (mrms_ak, icon_d2, ...).
# docs/sources/README.md describes each. Empty (FEEDS=) runs none.
# FEEDS=mrms,hrrr,gfs,alerts,stations

# Who runs this server and how to reach them, sent to every data provider.
# The NWS and MET Norway require it, for example:
#   UPSTREAM_USER_AGENT=my-weather-map (https://example.org/contact)
UPSTREAM_USER_AGENT=weather-map-dev

# Read severe-weather alerts from the world's national feeds as well as the
# US National Weather Service.
WORLD_ALERTS=true

# Web Push (VAPID). Generate a pair with: cargo run -p wx-server -- gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:set-your-contact@example.com

# Built web client served at /
WEB_DIST=./web/dist

# Basemap: a PMTiles archive (scripts/fetch-basemap.sh makes the local one),
# or BASEMAP_URL for one hosted elsewhere.
BASEMAP_PATH=./data/basemap/world.pmtiles
# BASEMAP_URL=

# How far to ingest forecasts: HRRR by forecast hour (18 covers every run,
# up to 48 uses the four long runs a day), GFS in hours ahead of now.
HRRR_MAX_HOUR=18
# How far ahead forecasts are fetched, in hours (7 days).
FORECAST_HOURS=168

# Memory for source grids kept warm for close-up tiles, in megabytes.
GRID_CACHE_MB=600
